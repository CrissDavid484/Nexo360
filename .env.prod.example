# =====================================================================
# CONFIGURACIÓN DE PRODUCCIÓN NEXO360 - VPS LINUX (Duoc UC - Sede Alameda)
# Copia este archivo a '.env' en la raíz de tu VPS antes de iniciar:
#   cp .env.prod.example .env
# Reemplaza TODOS los marcadores <REEMPLAZAR_...> antes de desplegar.
# =====================================================================

# Puerto HTTP público expuesto por el contenedor Nginx en el host del VPS
APP_PORT=80

# =====================================================================
# BASE DE DATOS MONGODB 7 (AUTENTICACIÓN OBLIGATORIA)
# =====================================================================
# Credenciales administrativas de MongoDB (solo para healthcheck e initdb)
MONGO_INITDB_ROOT_USERNAME=<REEMPLAZAR_USUARIO_ROOT_MONGO>
MONGO_INITDB_ROOT_PASSWORD=<REEMPLAZAR_CLAVE_ROOT_MONGO_SEGURA>

# Credenciales de aplicación con privilegios mínimos (readWrite sobre nexo360)
MONGO_APP_USER=<REEMPLAZAR_USUARIO_APP_NEXO360>
MONGO_APP_PASSWORD=<REEMPLAZAR_CLAVE_APP_NEXO360_SEGURA>

# =====================================================================
# SEGURIDAD Y ENRUTAMIENTO DEL BACKEND (OBLIGATORIOS EN PRODUCCIÓN)
# =====================================================================
# Clave secreta criptográfica (>= 32 caracteres). Generar con: openssl rand -base64 48
JWT_SECRET=<REEMPLAZAR_SECRETO_JWT_MIN_32_CHARS>

# URL pública oficial de Nexo360 (sin barra inclinada al final, ej: https://nexo360.duoc.cl)
FRONTEND_URL=<REEMPLAZAR_URL_PUBLICA_FRONTEND>
APP_PUBLIC_URL=<REEMPLAZAR_URL_PUBLICA_APP>

# Flags estrictos de producción (validateProductionConfig aborta si valen true)
ENABLE_DEMO_ACCOUNTS=false
ALLOW_IN_MEMORY_FALLBACK=false

# =====================================================================
# INTEGRACIÓN MICROSOFT ENTRA ID / VIVO DUOC (OPCIONAL - VACÍO POR DEFECTO)
# =====================================================================
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_CLIENT_SECRET=
AZURE_ENTRA_REDIRECT_URI=

# =====================================================================
# INTEGRACIÓN SICOL (OPCIONAL - VACÍO POR DEFECTO)
# =====================================================================
SICOL_API_URL=
SICOL_API_KEY=
SICOL_CLIENT_ID=

# =====================================================================
# INTEGRACIÓN LIBCAL BIBLIOTECA (OPCIONAL - VACÍO POR DEFECTO)
# =====================================================================
LIBCAL_BASE_URL=
LIBCAL_CLIENT_ID=
LIBCAL_CLIENT_SECRET=

# =====================================================================
# SERVICIO DE CORREO SMTP INSTITUCIONAL (OPCIONAL - VACÍO POR DEFECTO)
# =====================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
