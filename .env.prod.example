# =====================================================================
# CONFIGURACIÓN DE PRODUCCIÓN NEXO360 - VPS LINUX (Duoc UC - Sede Alameda)
# Copia este archivo a '.env' en la raíz de tu VPS antes de iniciar.
# Comando en VPS: cp .env.prod.example .env
# =====================================================================

# Puerto HTTP público expuesto por el contenedor Nginx en el host del VPS
# Por defecto 80 para tráfico web directo. Si usas Caddy o Nginx en el host para SSL, puedes usar 8080.
APP_PORT=80

# Clave secreta criptográfica para la firma de tokens JWT de sesión (OBLIGATORIA)
# Genera una clave segura de 32+ bytes ejecutando en tu terminal: openssl rand -base64 32
JWT_SECRET=genera_una_clave_jwt_robusta_y_segura_para_produccion_2026_duoc

# URL pública de acceso a Nexo360 (sin barra inclinada al final)
# Si accedes directamente por IP: http://TU_IP_PUBLICA
# Si accedes con nombre de dominio: https://nexo360.tudominio.cl
FRONTEND_URL=http://localhost
APP_PUBLIC_URL=http://localhost

# =====================================================================
# SERVICIO DE CORREO SMTP INSTITUCIONAL / NOTIFICACIONES (OPCIONAL)
# Si estos campos se dejan vacíos, el backend opera en modo vista previa segura,
# mostrando los códigos de recuperación de contraseña en los logs de la consola.
# =====================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nexo360 Duoc UC <no-reply@duocuc.cl>
